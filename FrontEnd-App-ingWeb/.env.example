# ── Sistema Canchas · variables de entorno ───────────────────────────────
# Copia este archivo a `.env` (que está ignorado por git) y ajusta si hace
# falta:  cp .env.example .env
#
# Interruptor mock ↔ API real (ver src/api/client.js):
#   VITE_USE_MOCK=true   → las páginas usan los datos de src/lib/mockData.js
#   VITE_USE_MOCK=false  → las páginas llaman a los endpoints reales
#
# Todos los valores deben ir con el prefijo VITE_ para que Vite los exponga.

# user-service (clientes) — DESIGN_SYSTEM §6
VITE_API_BASE=http://localhost:8080

# auth-service (login / registro) — DESIGN_SYSTEM §6
VITE_AUTH_BASE=http://localhost:8081

# Mientras el backend no exponga canchas ni reservas, déjalo en true.
VITE_USE_MOCK=true
